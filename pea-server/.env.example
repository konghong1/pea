# ============================================================
# pea Creative OS — 生产环境配置模板
# 用法: 复制为 pea-server/.env 后按需修改, docker compose 自动读取
#   cp .env.example .env && vim .env && ./start.sh --build
# 注意: .env 已被根目录 .gitignore 忽略, 切勿提交真实口令!
# ============================================================

# ---- 管理员账号 (BFF 启动幂等同步; 改密码后 docker compose up -d bff 即可) ----
PEA_ADMIN_PASSWORD=change-me-strong-admin-pass

# ---- JWT 签名密钥: 生产必须改成 32+ 位随机串, 否则会话可被伪造 ----
# 生成:  openssl rand -hex 32
PEA_JWT_SECRET=dev-secret-change-me

# ---- MySQL ----
PEA_DB_USER=pea
PEA_DB_PASSWORD=change-me-strong-db-pass
PEA_DB_ROOT_PASSWORD=change-me-strong-root-pass

# ---- MinIO (媒体存储; 改后需与 web 容器 /media 代理一致) ----
PEA_MINIO_ACCESS_KEY=change-me-minio-access
PEA_MINIO_SECRET_KEY=change-me-minio-secret

# ============================================================
# 部署提示 (docker-compose.yml 已默认把 3306/6379/9000/9001 绑定到 127.0.0.1,
# 仅本机可达; 容器间仍走 docker 内网互通, 不受影响):
#   - 改了上面口令后首次启动请用 ./start.sh --build 重建
#   - 已存在的 mysql_data 卷以旧口令为准, 迁移时需保持口令不变
#   - 对外只暴露 web:8088 / bff:4100 / orchestrator:8000
#   - 生产建议在本机再放一层 nginx/caddy 做 HTTPS 反向代理
# ============================================================
