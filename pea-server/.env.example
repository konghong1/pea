# ============================================================
# pea Creative OS — 生产环境配置模板
# 用法: 复制为 pea-server/.env 后按需修改, docker compose 自动读取
#   cp .env.example .env && vim .env && ./start.sh --build
# 注意: .env 已被根目录 .gitignore 忽略, 切勿提交真实口令!
# ============================================================

# ---- 管理员账号 (BFF 启动幂等同步; 改密码后 docker compose up -d bff 即可) ----
PEA_ADMIN_PASSWORD=change-me-strong-admin-pass

# ---- JWT 签名密钥: 生产必须改成 32+ 位随机串, 否则会话可被伪造 ----
# 生成:  openssl rand -hex 32
PEA_JWT_SECRET=dev-secret-change-me

# ---- MySQL ----
PEA_DB_USER=pea
PEA_DB_PASSWORD=change-me-strong-db-pass
PEA_DB_ROOT_PASSWORD=change-me-strong-root-pass

# ---- MinIO (媒体存储; 改后需与 web 容器 /media 代理一致) ----
PEA_MINIO_ACCESS_KEY=change-me-minio-access
PEA_MINIO_SECRET_KEY=change-me-minio-secret

# ---- 外部 AI 接口 DNS (绕过被污染 DNS, 可选叠加) ----
# 宿主 DNS 被污染时(如把 apihub.agnes-ai.com 指向假 IP), 容器解析不到外部 AI 域名会拉取失败/出图失败。
# 修复: 由 start.sh 在 PEA_DNS_FIX=1(默认)时叠加 docker-compose.dns-override.yml, 给 bff/orchestrator 指定干净公共 DNS
# (223.5.5.5 阿里 / 119.29.29.29 腾讯), 自动解析真实 IP 且支持多 IP 轮询, 不写死单点。
# ★ 若你的环境 DNS 本来就正常、能直接访问外部 AI: 把下面 PEA_DNS_FIX 设为 0, 完全不叠加, 走默认解析 (不强制)。
# 兜底: 若公共 DNS 也被污染, 写死单 IP 兜底: echo "APIHUB_REAL_IP=1.2.3.4" >> .env 并手改 dns-override.yml 用 extra_hosts。
PEA_DNS_FIX=1

# ---- 出网代理修复 (可选, 默认关闭) ----
# 当宿主有"出网代理"(如 WorkBuddy 沙箱代理, 监听宿主 33210) 且容器直连境外域名被污染/封锁时, 设 1。
# start.sh 叠加 docker-compose.proxy-override.yml: 容器经 host.docker.internal 走宿主代理出网
# (镜像 ai-agent 的方案)。前置: 宿主代理须在 33210 运行, 否则出网 ECONNREFUSED。
# ★ 服务器上没有本地代理时保持 0！误设 1 的症状: 拉模型/出图报
#   "connect ECONNREFUSED 172.17.0.1:33210"。部署前先跑 ./check-egress.sh 判定。
# 改代理地址: PEA_EGRESS_PROXY=http://host.docker.internal:<port>
PEA_PROXY_FIX=0

# ============================================================
# 部署提示 (docker-compose.yml 已默认把 3306/6379/9000/9001 绑定到 127.0.0.1,
# 仅本机可达; 容器间仍走 docker 内网互通, 不受影响):
#   - 改了上面口令后首次启动请用 ./start.sh --build 重建
#   - 已存在的 mysql_data 卷以旧口令为准, 迁移时需保持口令不变
#   - 对外只暴露 web:8088 / bff:4100 / orchestrator:8000
#   - 生产建议在本机再放一层 nginx/caddy 做 HTTPS 反向代理
# ============================================================
