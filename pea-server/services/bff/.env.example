# BFF 环境变量 (复制为 .env 后填真实值)
PEA_PORT=4000
PEA_JWT_SECRET=change-me-in-prod
PEA_JWT_EXPIRES_IN=7d

# MySQL
PEA_DB_HOST=mysql
PEA_DB_PORT=3306
PEA_DB_USER=pea
PEA_DB_PASSWORD=pea_dev
PEA_DB_NAME=pea

# Redis (事件 + 限流)
PEA_REDIS_URL=redis://redis:6379/0

# 对象存储 (S3 兼容 / MinIO)
PEA_MINIO_ENDPOINT=minio:9000
PEA_MINIO_ACCESS_KEY=minioadmin
PEA_MINIO_SECRET_KEY=minioadmin
PEA_MINIO_USE_SSL=false
PEA_MINIO_BUCKET=pea-media
PEA_CDN_BASE_URL=http://localhost:9000/pea-media

# 下游服务
PEA_ORCHESTRATOR_URL=http://generation-orchestrator:8000
PEA_INTERNAL_SERVICE_TOKEN=change-me-in-prod

# 管理员账户 (启动时幂等同步: 设置 PEA_ADMIN_PASSWORD 后密码以环境为准; 留空则不修改库内密码)
PEA_ADMIN_EMAIL=admin@pea.ai
PEA_ADMIN_PASSWORD=admin12345

# 新用户赠送 Tapies
PEA_FREE_TAPIES=1000
# 每用户每分钟请求上限 (简单内存限流, 生产换 Redis)
PEA_RATE_LIMIT_PER_MIN=120
