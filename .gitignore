# ===== AI Agent / MCP 产物（session 本地，不共享） =====
.claude/
.playwright-mcp/

# ===== WorkBuddy =====
# 只跟踪 skills 源码，memory/artifacts/backups 均为本地运行产物不共享
.workbuddy/memory/
.workbuddy/artifacts/
.workbuddy/backups/

# ===== Secrets (NEVER commit) =====
.env
.env.local
.env.*.local

# ===== Dependencies =====
node_modules/
.pnp/
.pnp.js
.yarn/

# ===== Build output =====
dist/
build/
out/
*.tsbuildinfo
# Vite 临时配置文件缓存（build/dev 时自动生成，非源码）
pea-server/web/vite.config.js.timestamp-*.mjs

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ===== Test / runtime artifacts =====
scripts/shots/
*.log
coverage/
.playwright-cli/
pea-server/.playwright-cli/
# 前端单测编译产物：统一由 verify/run-ts-tests.mjs 输出到 .workbuddy/artifacts/ts-test-build/。
# pea-server/web/tmp/ 是早期手工 esbuild 编译测试留下的散落产物，已被 runner 取代，可安全删除。
pea-server/web/tmp/

# ===== OS / Editor =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# verify/ : 验证脚本(*.py)纳入版本管理；截图/二进制/报告等产物忽略
verify/**/*.png
verify/**/*.jpg
verify/**/*.jpeg
verify/**/*.gif
verify/**/*.bmp
verify/**/*.webp
verify/**/*.log
verify/**/*.bin
verify/**/*.json
verify/**/*.md
verify/**/*.html
verify/**/*.txt
verify/**/*.yaml
verify/**/*.yml
verify/**/__pycache__/
# Agent 调试/一次性脚本与产物（保留 *.py 主验证脚本，忽略 debug/临时脚本）
verify/debug_*.py
verify/debug_*.mjs
verify/test_*.mjs
verify/*_style_test.py
verify/generate_*.py
verify/crop_*.py
verify/cursor*.png
verify/cursor*.txt

# ===== WorkBuddy / agent working artifacts (NEVER commit) =====
# 记忆、技能、运行产物、变更概览等均不进版本管理；只保留项目本身的源码与文档
# ★ 约定：agent 产出的报告/概览/排查记录一律写入 .workbuddy/artifacts/，禁止落在仓库根目录。
#   （skills/ 和 memory/ 保留跟踪，artifacts/ 和 backups/ 忽略）
docs/overviews/
overview_*.md
pea-server/*_overview.md

# ===== Agent Teams / deep agent working artifacts (NEVER commit) =====
# AgentTeams 团队会话产物：成员inbox、archive、retired-members 等均为运行时数据
.agent-teams/

# ===== Code analysis reports (NEVER commit) =====
# 代码分析报告、优化报告等分析产物
pea-code-analyzer/

# ===== Agent build / debug logs (NEVER commit) =====
verify/build_*.log
verify/cursors*.txt

# ===== AI agent scratch / temp files =====
*.tmp
*.temp
*~

# 兜底：仓库根目录下的一切报告类产物（前导 / 表示仅匹配根目录，不影响子目录同名源码）
/overview.md
/*-overview.md
/*_overview.md
/*-report.md
/*_report.md
/*-rootcause.md
/*_rootcause.md
/*-analysis.md
/*_analysis.md
/*-summary.md
/*_summary.md
# 调试期导出的画布数据 dump
/canvas_*.json
# 说明：一次性生成/调试脚本请放 verify/（验证脚本）或 .workbuddy/artifacts/（临时产物），
#      不要留在仓库根目录。

# Agent 临时产物
*.bak
*_edit.*

# Agent/开发者临时截图（根目录）
canvas-*.png
before-fix.png
